{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=cronograma-capilar.db"
  },
  "Jwt": {
    "Issuer": "CronogramaCapilar.API",
    "Audience": "CronogramaCapilar.App",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "ProductCatalog": {
    "BaseUrl": "https://world.openbeautyfacts.org/",
    "UserAgent": "CronogramaCapilar/1.0",
    "SearchCacheMinutes": 30,
    "ProductCacheHours": 24,
    "NotFoundCacheMinutes": 60
  }
}
